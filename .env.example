# ─── Supabase ─────────────────────────────────────────────────────
# Dapatkan dari: https://supabase.com/dashboard/project/[ID]/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ─── OpenRouter API ────────────────────────────────────────────────
# Dapatkan dari: https://openrouter.ai/keys
# Digunakan untuk: Chatbot AI (Gemini 2.5 Flash), Face Mood Tracker, Dermatologi AI, Symptom Triage
# Format key harus: sk-or-v1-xxxx
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
VITE_GEMINI_FACE_API_KEY=sk-or-v1-your-openrouter-key-here

# ─── Gemini API Langsung (opsional, OpenRouter lebih direkomendasikan) ─
# Dapatkan dari: https://aistudio.google.com/app/apikey
# Format key harus: AIza... (bukan AQ...)
VITE_GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Groq API (Voice STT) ─────────────────────────────────────────
# Dapatkan dari: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your-groq-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# ─── ElevenLabs (Voice Conversational AI) ────────────────────────
# Dapatkan dari: https://elevenlabs.io/app/conversational-ai
VITE_ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here
VITE_ELEVENLABS_AGENT_ID=agent_your-agent-id-here

# ─── Midtrans Payment ─────────────────────────────────────────────
# Dapatkan dari: https://dashboard.midtrans.com/settings/config_info
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
VITE_MIDTRANS_ENV=sandbox
MIDTRANS_ENV=sandbox
